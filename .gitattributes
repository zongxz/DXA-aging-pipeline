# 统一换行符：脚本要在 Linux 上运行，一律 LF
* text=auto eol=lf

*.sh    text eol=lf
*.R     text eol=lf
*.r     text eol=lf
*.py    text eol=lf
*.ipynb text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.pdf   binary
*.gz    binary
*.h5ad  binary
*.pth   binary
